      <aliases enabled='yes' />
      <column caption='GMV_score' datatype='real' name='[Calculation_591660443299217419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_gmv]) / WINDOW_MAX(SUM([total_gmv]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Avg_GMV_Score' datatype='real' name='[Calculation_591660443299684364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_order_value]) / WINDOW_MAX( AVG([avg_order_value]) )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Repurchase_Score' datatype='real' name='[Calculation_591660443302117392]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([repeat_customers] / [unique_customers]) / &#13;&#10;WINDOW_MAX( AVG([repeat_customers] / [unique_customers]) )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Review_Score' datatype='real' name='[Calculation_591660443302207505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([avg_rating]) / WINDOW_MAX(AVG([avg_rating]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Delay_Score' datatype='real' name='[Calculation_591660443302285330]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - ( AVG([delay_rate_pct]) / WINDOW_MAX(AVG([delay_rate_pct])) )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI_Score' datatype='real' name='[Calculation_591660443302346771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_591660443299217419] * 0.25 +&#13;&#10;[Calculation_591660443299684364] * 0.20 +&#13;&#10;[Calculation_591660443302117392] * 0.25 +&#13;&#10;[Calculation_591660443302207505] * 0.20 +&#13;&#10;[Calculation_591660443302285330] * 0.10'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
